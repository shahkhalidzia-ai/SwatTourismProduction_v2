# ==============================================================================
# Swat Tourism Platform - Production Environment Variables
# ==============================================================================

# Core Application
PROJECT_NAME="Swat Tourism Platform (Production)"
API_V1_STR="/api/v1"
PORT=8090

# Database Engine
# High-Performance SQLite in WAL mode with connection pooling
DATABASE_URL="sqlite+aiosqlite:///./backend/swat_tourism_prod.db"
DATABASE_SYNC_URL="sqlite:///./backend/swat_tourism_prod.db"
SQLITE_WAL_MODE=true

# Cryptographic Security
SECRET_KEY="swat_tourism_prod_secure_secret_key_99482910485720184729"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Commercial Pakistani Payment Gateways
# Easypaisa
EASYPAISA_STORE_ID="swat_tourism_store"
EASYPAISA_HASH_KEY="EP_SEC_KEY_SWAT_TOURISM_2026"
EASYPAISA_MERCHANT_ID="EP_MCH_99412"
EASYPAISA_ENV="sandbox"
EASYPAISA_CALLBACK_URL="https://swat-tourism.pk/api/v1/bookings/easypaisa/ipn-callback"

# JazzCash
JAZZCASH_MERCHANT_ID="MC994120"
JAZZCASH_PASSWORD="jazz_pw_swat_2026"
JAZZCASH_INTEGRITY_SALT="salt_jazz_swat_sec_8841928"
JAZZCASH_ENV="sandbox"
JAZZCASH_RETURN_URL="https://swat-tourism.pk/api/v1/bookings/jazzcash/ipn-callback"

# Telecom Cellular SMS Gateway
SMS_PROVIDER="mock"
SMS_API_KEY="swat_sms_key_mock_99182"
SMS_API_SECRET="swat_sms_secret_mock"
SMS_SENDER_ID="SWAT-TOURISM"

# Live Regional Meteorology Feeds
WEATHER_PROVIDER="mock"
OPENWEATHER_API_KEY="mock_weather_key"
WEATHER_CACHE_TTL_SECONDS=3600

# Emergency Services Bridge
RESCUE_1122_CAD_WEBHOOK_URL="https://cad-dispatch.rescue1122.gov.pk/api/v1/incidents"
RESCUE_1122_API_KEY="r1122_swat_cad_token_demo"
RESCUE_1122_ESCALATION_EMAIL="dispatch.swat@rescue1122.gov.pk"
RESCUE_1122_ENABLED=true

# High-Performance Storage
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"

# CORS Production Allowed Origins
CORS_ORIGINS=["https://swat-tourism.pk","https://www.swat-tourism.pk","http://localhost:5180","http://localhost:3000"]
