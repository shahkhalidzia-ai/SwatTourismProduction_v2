# Swat Tourism Frontend Development Environment
# To override the backend proxy target in Vite dev server (defaults to http://127.0.0.1:8090):
VITE_BACKEND_URL=http://127.0.0.1:8090

# Optional: To bypass Vite proxy and connect directly to a remote backend:
# VITE_API_URL=http://localhost:8090/api/v1

# Demo switcher bar mode (set to false in production to enforce strict role routing)
VITE_DEMO_MODE=true
