# Example Environment Configuration for Swat Tourism Platform Backend
# Copy to backend/.env and select your WhatsApp provider.

# --- WhatsApp Provider ('mock' | 'waha' | 'meta' | 'twilio') ---
WHATSAPP_PROVIDER=waha

# --- Option A: WAHA (Local & Self-Hosted Testing) ---
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=

# --- Option B: Meta WhatsApp Cloud API (Production Recommended) ---
# WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

